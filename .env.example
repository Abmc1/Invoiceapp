# -----------------------------------------------------------------------------
# MotivAction Invoicing — environment variables
# Copy this file to .env.local (development) or configure these in your
# hosting provider's dashboard (production). Never commit real values.
# -----------------------------------------------------------------------------

# PostgreSQL connection string. Required.
# Local Docker example:      postgres://postgres:postgres@localhost:5432/motivaction
# Neon / Supabase (hosted):  postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret key used to sign session cookies. Required, at least 32 characters.
# Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the deployed app (used in emailed links, PDF footers, etc.)
APP_URL=http://localhost:3000

# Postgres connection pool size (optional, default 10).
# DB_POOL_MAX=10

# Bearer token that must be sent as "Authorization: Bearer <value>" to call
# /api/cron/reminders. Required in production (the endpoint refuses to run
# without it once NODE_ENV=production) — generate with `openssl rand -hex 32`.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Email — REQUIRED for real use, not just optional polish: login now requires
# a 6-digit code sent by email as a second factor after the password, so
# without a real provider configured, codes only appear in the server console
# (EMAIL_PROVIDER=mock, the default) instead of actually arriving by email.
#
# To send real email (including 2FA codes) via Microsoft 365 / Outlook
# (MotivAction's actual email provider):
#   1. An admin must enable "Authenticated SMTP" for this mailbox — Microsoft
#      disables it tenant-wide by default (Microsoft 365 admin center > Users
#      > Active users > select user > Mail tab > Manage email apps).
#   2. If MFA is enforced on the account, SMTP_PASSWORD must be an App
#      Password from mysignins.microsoft.com/security-info, not the normal
#      sign-in password.
#   3. Set EMAIL_PROVIDER=smtp and fill in SMTP_PASSWORD below.
# See README.md > Email configuration for full details, including Gmail as
# an alternative and other SMTP providers (Postmark, SES, Resend, etc).
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=a.burkemccarthy@motivaction.ie
SMTP_PASSWORD=
EMAIL_FROM="MotivAction <a.burkemccarthy@motivaction.ie>"

# -----------------------------------------------------------------------------
# Seed / bootstrap admin account (development only)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=a.burkemccarthy@motivaction.ie
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="Audrey Burke McCarthy"
